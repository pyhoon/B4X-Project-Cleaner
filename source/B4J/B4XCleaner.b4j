Sub Process_Globals
	Private fx As JFX
	Private MainForm As Form
	Type FileInfo (Name As String, Folder As String, FileType As String, FileSize As Long, Selected As Boolean)
End Sub

Sub AppStart (Form1 As Form, Args() As String)
	MainForm = Form1
	MainForm.Show
	MainForm.Title = "B4X Temp Cleaner"
	Dim PagesManager As B4XPagesManager
	PagesManager.Initialize(MainForm)
End Sub

